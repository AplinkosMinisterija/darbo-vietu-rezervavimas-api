# =============================================================================
# stalu-rezervavimas-api environment configuration
#
# Copy to `.env` for local development. In production these are wired from
# biip-infra `environments/<env>/.env` as `INPUT_STALU_REZERVAVIMAS_*`.
# =============================================================================

# Node runtime mode. `production` enables fail-fast guards on JWT_SECRET and
# enables Secure cookie attribute by default.
NODE_ENV=development

# Postgres connection string. Local dev: spin up postgres via docker-compose
# from biip-infra OR `docker run -e POSTGRES_PASSWORD=stalu -p 5432:5432 postgres:15`.
DB_CONNECTION=postgresql://stalu:stalu@localhost:5432/stalu_dev

# JWT signing secret. MUST be set to a strong random value (>=32 chars) in prod.
# In non-production the placeholder is tolerated with a console warning so that
# `yarn dev` works without bootstrap wiring.
# Generate: `openssl rand -hex 32`
JWT_SECRET=dev-jwt-secret-change-me

# Microsoft Azure AD / Entra ID application credentials. Created by the IT
# admin in Azure portal; the same app registration is shared across dev/prod
# but each environment has its own client secret (rotated independently).
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=

# OAuth callback URI. MUST match exactly one of the Redirect URIs registered
# in the Azure app. Local dev typically uses http://localhost:3000/api/auth/outlook/callback.
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback

# CORS allowed origins (comma-separated). FE dev server runs on :5173.
CORS_ORIGINS=http://localhost:5173

# Frontend origin used for post-login redirects (302 after successful callback).
FRONTEND_ORIGIN=http://localhost:5173

# Optional cookie Domain attribute. Empty value = per-host cookie (recommended).
# Set only if api + web live on different subdomains of the same parent and
# you need the cookie to cross subdomains. NEVER set in dev (localhost cookies
# with Domain= attribute behave inconsistently across browsers).
COOKIE_DOMAIN=

# Bootstrap admin email. The first user who logs in with this email is
# promoted to ROLE_ADMIN on auto-create. Used only when the `users` table is
# empty — once an admin exists, this var has no effect.
BOOTSTRAP_ADMIN_EMAIL=
