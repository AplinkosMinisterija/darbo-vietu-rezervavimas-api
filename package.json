{
  "name": "stalu-rezervavimas-api",
  "version": "0.1.0",
  "private": true,
  "description": "Stalų rezervavimo sistema (Moleculer.js API)",
  "repository": "github:AplinkosMinisterija/stalu-rezervavimas-api",
  "license": "UNLICENSED",
  "scripts": {
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "build": "tsc --build tsconfig.json",
    "dev": "yarn db:migrate && ts-node ./node_modules/moleculer/bin/moleculer-runner.js --env --hot --repl --config moleculer.config.ts services/**/*.service.ts",
    "start": "knex migrate:latest --knexfile /app/dist/knexfile.js && cd /app/dist && SERVICEDIR=/app/dist/services node /app/node_modules/moleculer/bin/moleculer-runner.js --config /app/dist/moleculer.config.js",
    "lint": "eslint --ext .js,.ts ."
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.0",
    "@moleculer/database": "github:ambrazasp/moleculerjs-database",
    "@sentry/node": "^7.60.1",
    "cookie": "^0.6.0",
    "dotenv": "^16.0.0",
    "jsonwebtoken": "^9.0.0",
    "knex": "^2.5.1",
    "lodash": "^4.17.21",
    "moleculer": "^0.14.20",
    "moleculer-db": "^0.8.17",
    "moleculer-decorators": "^1.3.0",
    "moleculer-sentry": "^2.0.0",
    "moleculer-web": "^0.10.4",
    "moment": "^2.29.4",
    "objection": "^3.0.1",
    "pg": "^8.7.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.178",
    "@types/node": "^20.4.5",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "moleculer-repl": "^0.7.0",
    "prettier": "^3.2.0",
    "ts-node": "^10.5.0",
    "typescript": "^4.9.5",
    "vitest": "^1.6.0"
  }
}
